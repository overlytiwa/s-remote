<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SamsungMiniRemote</AssemblyName>
    <RootNamespace>SamsungMiniRemote</RootNamespace>
    <ApplicationIcon>Assets\remote.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\remote.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
