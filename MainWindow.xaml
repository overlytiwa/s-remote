<Window x:Class="SamsungMiniRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:SamsungMiniRemote.Controls"
        Title="S-Remote"
        Width="295" Height="580"
        MinWidth="295" MinHeight="580"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- Restrained, near-black surfaces with soft gray line icons. -->
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F2"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#898990"/>
        <SolidColorBrush x:Key="IconGray" Color="#92929A"/>
        <SolidColorBrush x:Key="KeyFill" Color="#1B1B1E"/>
        <SolidColorBrush x:Key="KeyFillHover" Color="#2A2A2E"/>
        <SolidColorBrush x:Key="KeyStroke" Color="#343438"/>

        <Style x:Key="CircularButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource KeyFill}"/>
            <Setter Property="Foreground" Value="{StaticResource IconGray}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="KeySurface"
                                    CornerRadius="100"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource KeyStroke}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.23" BlurRadius="6" ShadowDepth="2"/>
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeySurface" Property="Background" Value="{StaticResource KeyFillHover}"/>
                                <Setter TargetName="KeySurface" Property="BorderBrush" Value="#55555A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeySurface" Property="Background" Value="#35353A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="KeySurface" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TVPickerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PickerSurface" CornerRadius="30"
                                Background="#1B1B1E" BorderBrush="#333337" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.23" BlurRadius="7" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PickerSurface" Property="Background" Value="#28282B"/>
                                <Setter TargetName="PickerSurface" Property="BorderBrush" Value="#55555A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PickerSurface" Property="Background" Value="#343438"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DpadButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DpadSurface" Background="{TemplateBinding Background}"
                                CornerRadius="32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DpadSurface" Property="Background" Value="#343438"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DpadSurface" Property="Background" Value="#45454B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DpadSurface" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleControlButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#27272A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#38383C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TV list popup item style -->
        <Style x:Key="TvListItem" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Transparent outside edge preserves the soft drop shadow and curved corners. -->
    <Grid Margin="8">
        <Border CornerRadius="24" Background="#0B0B0D"
                BorderBrush="#2B2B30" BorderThickness="1" Padding="13,9,13,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.55" ShadowDepth="6"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="74"/>
                </Grid.RowDefinitions>

                <!-- Title bar with badge, drag zone, and window controls -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="Transparent" Grid.Column="0"
                            MouseLeftButtonDown="DragZone_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Ellipse Width="5" Height="5" Fill="#56565B" Margin="0,0,7,0"/>
                            <TextBlock x:Name="BadgeText" Text="S-Remote" Foreground="#808086" FontSize="9"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="1" Style="{StaticResource TitleControlButton}"
                            Width="23" Height="23" ToolTip="Minimize"
                            Click="Minimize_Click">
                        <icons:LucideIcon Kind="Minus" Width="13" Height="13" Foreground="#9B9BA2"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource TitleControlButton}"
                            Width="23" Height="23" ToolTip="Hide to system tray"
                            Click="Close_Click">
                        <icons:LucideIcon Kind="Close" Width="13" Height="13" Foreground="#9B9BA2"/>
                    </Button>
                </Grid>

                <!-- Second row: Mute, TV picker, Power -->
                <Grid Grid.Row="1" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnMute" Grid.Column="0" Style="{StaticResource CircularButton}"
                            Width="44" Height="44" ToolTip="Mute"
                            Click="Mute_Click">
                        <icons:LucideIcon x:Name="MuteIcon" Kind="VolumeOn" Width="20" Height="20" Foreground="#93939B"/>
                    </Button>

                    <Button x:Name="BtnTvPicker" Grid.Column="1" Style="{StaticResource TVPickerButton}"
                            Margin="7,0,7,0" Height="44" ToolTip="Choose a TV"
                            Click="TvPicker_Click">
                        <Grid Margin="14,0,11,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>
                            <!-- Connection status indicator dot -->
                            <Ellipse x:Name="StatusDot" Grid.Column="0" Width="6" Height="6"
                                     Fill="#555558" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TvPickerText" Grid.Column="1" Text="Choose a TV"
                                       FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#F2F2F4" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <icons:LucideIcon Grid.Column="3" Kind="ChevronDown" Width="16" Height="16"
                                              Foreground="#787880" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="BtnPower" Grid.Column="2" Style="{StaticResource CircularButton}"
                            Width="44" Height="44" ToolTip="Power"
                            Click="Power_Click">
                        <icons:LucideIcon Kind="Power" Width="21" Height="21" Foreground="#85858D"/>
                    </Button>
                </Grid>

                <!-- Trackpad: directional D-pad -->
                <Border Grid.Row="2" Margin="0,10,0,10"
                        CornerRadius="32" Background="#212123" BorderBrush="#252528"
                        BorderThickness="1">
                    <Grid Width="195" Height="195" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="65"/>
                            <RowDefinition Height="65"/>
                            <RowDefinition Height="65"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="65"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnUp" Grid.Row="0" Grid.Column="1" Style="{StaticResource DpadButton}"
                                Width="54" Height="54" ToolTip="Up" Click="DpadUp_Click">
                            <icons:LucideIcon Kind="ArrowUp" Width="18" Height="18" Foreground="#929299"/>
                        </Button>
                        <Button x:Name="BtnLeft" Grid.Row="1" Grid.Column="0" Style="{StaticResource DpadButton}"
                                Width="54" Height="54" ToolTip="Left" Click="DpadLeft_Click">
                            <icons:LucideIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="#929299"/>
                        </Button>
                        <Button x:Name="BtnOk" Grid.Row="1" Grid.Column="1" Style="{StaticResource DpadButton}"
                                Background="#353538" Width="55" Height="55" ToolTip="OK / Select"
                                Click="DpadOk_Click">
                            <TextBlock Text="OK" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E4"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnRight" Grid.Row="1" Grid.Column="2" Style="{StaticResource DpadButton}"
                                Width="54" Height="54" ToolTip="Right" Click="DpadRight_Click">
                            <icons:LucideIcon Kind="ArrowRight" Width="18" Height="18" Foreground="#929299"/>
                        </Button>
                        <Button x:Name="BtnDown" Grid.Row="2" Grid.Column="1" Style="{StaticResource DpadButton}"
                                Width="54" Height="54" ToolTip="Down" Click="DpadDown_Click">
                            <icons:LucideIcon Kind="ArrowDown" Width="18" Height="18" Foreground="#929299"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Volume rocker -->
                <Border Grid.Row="3" Margin="0,0,0,7"
                        CornerRadius="22" Background="#1B1B1E"
                        BorderBrush="#343438" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnVolDown" Grid.Column="0" Style="{StaticResource DpadButton}"
                                Margin="3" ToolTip="Volume down"
                                AutomationProperties.Name="Volume down"
                                Click="VolDown_Click"
                                PreviewMouseLeftButtonDown="VolDown_MouseDown"
                                PreviewMouseLeftButtonUp="VolRepeat_MouseUp"
                                MouseLeave="VolRepeat_MouseUp">
                            <icons:LucideIcon Kind="VolumeDown" Width="20" Height="20"
                                              Foreground="#9999A1"/>
                        </Button>
                        <TextBlock Grid.Column="1" Text="VOLUME" FontSize="8.5" FontWeight="SemiBold"
                                   Foreground="#77777F" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <Button x:Name="BtnVolUp" Grid.Column="2" Style="{StaticResource DpadButton}"
                                Margin="3" ToolTip="Volume up"
                                AutomationProperties.Name="Volume up"
                                Click="VolUp_Click"
                                PreviewMouseLeftButtonDown="VolUp_MouseDown"
                                PreviewMouseLeftButtonUp="VolRepeat_MouseUp"
                                MouseLeave="VolRepeat_MouseUp">
                            <icons:LucideIcon Kind="VolumeUp" Width="20" Height="20"
                                              Foreground="#9999A1"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Bottom row: Play/Pause, Back, Home -->
                <Grid Grid.Row="4" Margin="3,0,3,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnPlayPause" Grid.Column="0" Style="{StaticResource CircularButton}"
                            Width="58" Height="58" ToolTip="Play / Pause"
                            Click="PlayPause_Click">
                        <icons:LucideIcon x:Name="PlayPauseIcon" Kind="Play" Width="22" Height="22" Foreground="#93939B"/>
                    </Button>
                    <Button x:Name="BtnBack" Grid.Column="1" Style="{StaticResource CircularButton}"
                            Width="70" Height="70" ToolTip="Back"
                            Click="Back_Click">
                        <icons:LucideIcon Kind="Undo" Width="26" Height="26" Foreground="#8B8B92"
                                          StrokeThickness="1.75"/>
                    </Button>
                    <Button x:Name="BtnHome" Grid.Column="2" Style="{StaticResource CircularButton}"
                            Width="58" Height="58" ToolTip="Home"
                            Click="Home_Click">
                        <icons:LucideIcon Kind="Home" Width="22" Height="22" Foreground="#929299"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- TV Discovery Popup (shown when clicking the TV picker) -->
        <Popup x:Name="TvPopup" StaysOpen="False" Placement="Bottom"
               PlacementTarget="{Binding ElementName=BtnTvPicker}"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#1A1A1D" CornerRadius="14" BorderBrush="#333337"
                    BorderThickness="1" Padding="6" MinWidth="230" MaxWidth="280"
                    MaxHeight="310">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" Color="Black" Opacity="0.6" ShadowDepth="5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Header -->
                    <TextBlock Grid.Row="0" Text="Samsung TVs on Network" FontSize="11"
                               FontWeight="SemiBold" Foreground="#808086" Margin="8,4,8,6"/>
                    <!-- TV List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                        <StackPanel x:Name="TvListPanel">
                            <TextBlock x:Name="TvSearchStatus" Text="Searching…" FontSize="11"
                                       Foreground="#707077" Margin="8,10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Rescan button -->
                    <Button Grid.Row="2" Style="{StaticResource DpadButton}"
                            Margin="4,4,4,2" Height="30" ToolTip="Rescan network"
                            Click="Rescan_Click">
                        <TextBlock Text="⟳ Rescan" FontSize="11" Foreground="#9999A1"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
